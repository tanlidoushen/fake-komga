# 环境变量配置
# 复制此文件为 .env 并填写

# Bangumi API 访问令牌（必填，用于元数据刮削）
# 获取方式：https://bangumi.tv/user/me/apps → 创建应用 → 获取 access_token
BANGUMI_ACCESS_TOKEN=

# 漫画目录路径（本地模式，映射到容器内的 /comics）
# 示例: COMICS_DIR=/path/to/your/comics
COMICS_DIR=/comics

# 代理设置（可选，用于访问 Bangumi API 等外网服务）
# HTTP_PROXY=http://your-proxy:7890

# 时区
TZ=Asia/Shanghai